rules_version = '2';

// Only ever loaded by the local Firestore emulator (see
// firebase.emulator.json), never deployed - deploy.sh only ever runs
// `firebase deploy --only hosting:todd-outreach`. Wide open on purpose:
// the emulator's data is thrown away between runs and never leaves this
// machine.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
